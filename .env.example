# Copy to .env, then: docker:up → db:migrate → db:seed → dev:api → bot:telegram → dev:web
# See README «Быстрый старт».

# PostgreSQL (docker compose → host port 5433)
DATABASE_URL=postgresql://autodoc:autodoc@localhost:5433/autodoc?schema=public

# Telegram (same bot for API deep-link + bot process)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=autodoc_bot

# Frontend / API origins (CORS allows APP_URL with credentials)
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# Sessions (httpOnly cookie; coordinated with web via /api/me)
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_NAME=autodoc_session

# API
PORT=3001
NODE_ENV=development
