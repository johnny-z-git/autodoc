{
  "name": "autodoc",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @autodoc/web",
    "dev:web": "npm run dev -w @autodoc/web",
    "dev:api": "npm run dev -w @autodoc/api",
    "dev:bot": "npm run dev -w @autodoc/bot",
    "bot:telegram": "npm run start -w @autodoc/bot",
    "build": "npm run build -w @autodoc/web",
    "build:web": "npm run build -w @autodoc/web",
    "build:api": "npm run build -w @autodoc/api",
    "build:bot": "npm run build -w @autodoc/bot",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  }
}
